+class StringLength(StringParamType):
+    """A string parameter whose length must fall within an optional range.
+
+    :param min_length: Minimum number of characters, inclusive. ``None`` means no minimum.
+    :param max_length: Maximum number of characters, inclusive. ``None`` means no maximum.
+    """
+
+    name = "text"
+
+    def __init__(
+        self, min_length: int | None = None, max_length: int | None = None
+    ) -> None:
+        if min_length is not None and max_length is not None and min_length > max_length:
+            raise ValueError("'min_length' cannot be greater than 'max_length'.")
+
+        self.min_length = min_length
+        self.max_length = max_length
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> str:
+        converted = super().convert(value, param, ctx)
+        length = len(converted)
+
+        if self.min_length is not None and length < self.min_length:
+            self.fail(
+                f"{converted!r} is too short; it must be at least"
+                f" {self.min_length} characters.",
+                param,
+                ctx,
+            )
+
+        if self.max_length is not None and length > self.max_length:
+            self.fail(
+                f"{converted!r} is too long; it must be at most"
+                f" {self.max_length} characters.",
+                param,
+                ctx,
+            )
+
+        return converted
+
+    def __repr__(self) -> str:
+        return f"StringLength(min_length={self.min_length}, max_length={self.max_length})"
+
+
 if t.TYPE_CHECKING:
